HOST=0.0.0.0
PORT=3150
# Postgres do docker-compose (porta 5436 no host)
DATABASE_URL=postgresql://docker:docker@localhost:5436/sistema_3d_dev
JWT_SECRET=change-me-sistema-3d-secret
JWT_EXPIRES_IN=12h
# API corporativa (validação de partnumber)
APPNAME=
APPKEY=
API_PEDERTRACTOR_URL=
# true = aceita qualquer partnumber sem consultar a API (apenas para desenvolvimento offline)
PART_VALIDATION_DISABLED=false
# true = não consulta a API de colaboradores e usa um colaborador fictício (apenas desenvolvimento offline)
EMPLOYEE_VALIDATION_DISABLED=false
# Pasta dos arquivos auxiliares enviados nas solicitações
UPLOADS_DIR=./uploads
UPLOAD_MAX_MB=50
# Cartão/unidade do admin criado pelo seed (senha inicial = cartão)
SEED_ADMIN_CARD=0001
SEED_ADMIN_UNIT=PEDERTRACTOR
